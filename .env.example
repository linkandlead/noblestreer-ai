# Kopieer naar .env (nooit committen). Zet dezelfde waarden als Environment Variables in Vercel.
# CMS_TOKEN is GEHEIM: alleen build-time, komt nooit in de browser. SITE_ID is publiek.
CMS_BASE=https://linkandlead.nl
CMS_TOKEN=cms_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SITE_ID=43419df5-06b4-437a-9632-fd3f242a8364
# Pas op "ja" zetten zodra het definitieve domein gekoppeld is (tot dan: noindex + robots Disallow).
INDEXEREN=nee
