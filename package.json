{
  "name": "noblestreet-ai",
  "private": true,
  "type": "module",
  "description": "Noblestreet AI — headless frontend (CMS-model A) op Link & Lead One.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node build.mjs",
